{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-12-26",
  "name": "skland-daily-attendance",
  "compatibility_flags": ["nodejs_als"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "KV","id": "b63f1f45f3594b54a9829a1f7e1c34e6"
    }
  ],
  "triggers": {
    "crons": ["30 0/2 * * *"]
  }
}
